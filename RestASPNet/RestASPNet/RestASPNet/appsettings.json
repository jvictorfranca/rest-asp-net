{
  "MSSQLServerSqlConnection": {
    "ConnectionString": "Data Source=localhost,1433;Initial Catalog=asp_net_10;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;"
  },
  "CORS": {
    "Origins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "http://localhost:8080"
    ]
  },
  "TokenConfiguration": {
    "Audience": "ExampleAudience",
    "Issuer": "ExampleIssuer",
    "Seconds": 86400,
    "Minutes": 60,
    "DaysToExpire": 7
  },
  "Email": {
    "Subject": "Default Subject",
    "Message": "Default message from api",
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "${EMAIL_USERNAME}",
    "Password": "${EMAIL_PASSWORD}",
    "Properties": {
      "SmtpAuth": "true",
      "SmtpStartTlsEnable": "true",
      "StartTlsRequired": "true"
    },
    "Ssl": true

  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
         "RestASPNet": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*"
}
